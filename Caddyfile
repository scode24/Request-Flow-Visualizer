{
    email admin@example.com
}

# Replace your-domain.com with your Hostinger VPS domain or server IP
{$DOMAIN:localhost} {
    # Serve static frontend
    handle /api/* {
        reverse_proxy backend:4000
    }

    handle /ws {
        reverse_proxy backend:4000
    }

    handle {
        reverse_proxy frontend:80
    }

    log {
        output file /var/log/caddy/access.log
    }
}
